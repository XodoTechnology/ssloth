# Random secret used to encrypt all credentials/keys at rest (AES-256-GCM).
# openssl rand -base64 48
SSLOTH_MASTER_KEY=

# Master-key rotation (opt-in, off by default): to rotate, set
# SSLOTH_MASTER_KEY to the NEW key and SSLOTH_MASTER_KEY_OLD to the CURRENT
# key, then restart — every stored secret is re-encrypted at boot. When the
# log reports "rotation complete", unset SSLOTH_MASTER_KEY_OLD and restart
# again. Leave unset for normal operation.
# SSLOTH_MASTER_KEY_OLD=

# OIDC single-sign-on (off by default — set ISSUER + CLIENT_ID to enable).
# The login page then shows "Sign in with SSO". See server/src/oidc.js for
# all knobs; the important ones:
#   SSLOTH_OIDC_ISSUER          https://idp.example.com/realms/myrealm
#   SSLOTH_OIDC_CLIENT_ID       registered client id
#   SSLOTH_OIDC_CLIENT_SECRET   for confidential clients
#   SSLOTH_OIDC_REDIRECT_URI    must match IdP registration; defaults to
#                               <scheme>://<host>/api/auth/oidc/callback
#   SSLOTH_OIDC_AUTO_PROVISION  'true' auto-creates users (role 'user' only)
# SSLOTH_OIDC_ISSUER=
# SSLOTH_OIDC_CLIENT_ID=
# SSLOTH_OIDC_CLIENT_SECRET=
# SSLOTH_OIDC_REDIRECT_URI=
# SSLOTH_OIDC_AUTO_PROVISION=false

# 'true' when ssloth is served over HTTPS so cookies get the Secure flag.
SSLOTH_SECURE_COOKIES=false

# Trust X-Forwarded-* headers (needed for correct client IPs behind a proxy).
# 'true', or a subnet like '10.0.0.0/8'. Default: off.
TRUST_PROXY=false

# Listen address/port for the ssloth server.
# PORT=8080
# BIND=0.0.0.0

# Allow SSH tunnels to bind non-loopback addresses. Even with this set,
# only admin accounts may create publicly-bound tunnels. Default: false —
# tunnels always bind 127.0.0.1/::1.
# SSLOTH_ALLOW_PUBLIC_TUNNELS=false

# Allow KVM virtual-media mounts from private/LAN http(s) URLs (e.g. an ISO
# server on your network). Off by default — media URLs must resolve to
# public addresses to prevent SSRF. Local file mounts are always limited to
# the server's media upload directory.
# SSLOTH_ALLOW_PRIVATE_MEDIA_URLS=false

# Hours of inactivity after which a login session is deleted server-side,
# even though its cookie still looks valid. Open terminals/KVM consoles count
# as activity. Default 24; set 0 to disable (not recommended).
# SSLOTH_SESSION_IDLE_HOURS=24

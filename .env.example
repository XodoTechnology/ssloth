# Random secret used to encrypt all credentials/keys at rest (AES-256-GCM).
# openssl rand -base64 48
SSLOTH_MASTER_KEY=

# 'true' when ssloth is served over HTTPS so cookies get the Secure flag.
SSLOTH_SECURE_COOKIES=false

# Trust X-Forwarded-* headers (needed for correct client IPs behind a proxy).
# 'true', or a subnet like '10.0.0.0/8'. Default: off.
TRUST_PROXY=false

# Listen address/port for the ssloth server.
# PORT=8080
# BIND=0.0.0.0

# Allow SSH tunnels to bind non-loopback addresses. Even with this set,
# only admin accounts may create publicly-bound tunnels. Default: false —
# tunnels always bind 127.0.0.1/::1.
# SSLOTH_ALLOW_PUBLIC_TUNNELS=false

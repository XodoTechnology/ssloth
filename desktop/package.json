{
  "name": "ssloth-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "ssloth desktop wrapper — runs the portal as a local app",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "prepare": "node prepare-standalone.js",
    "dist": "node prepare-standalone.js && electron-builder --win",
    "dist:linux": "node prepare-standalone.js --platform linux && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.ssloth.app",
    "productName": "ssloth",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/server",
        "to": "server"
      },
      {
        "from": "stage/web/dist",
        "to": "web/dist"
      },
      {
        "from": "stage/node",
        "to": "node"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ssloth"
    }
  }
}

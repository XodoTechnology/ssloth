{
  "name": "ssloth-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "ssloth desktop wrapper — runs the portal as a local app",
  "author": "ssloth <dev@ssloth.local>",
  "homepage": "https://github.com/your-org/ssloth",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "prepare": "node prepare-standalone.js",
    "dist": "node prepare-standalone.js && electron-builder --win",
    "dist:linux": "node prepare-standalone.js --platform linux && electron-builder --linux",
    "dist:mac": "node prepare-standalone.js --platform darwin && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.ssloth.app",
    "productName": "ssloth",
    "directories": {
      "output": "release"
    },
    "icon": "icon.png",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/server",
        "to": "server"
      },
      {
        "from": "stage/web/dist",
        "to": "web/dist"
      },
      {
        "from": "stage/node",
        "to": "node"
      },
      {
        "from": "../tools",
        "to": "tools",
        "filter": [
          "**/*",
          "!fixtures/**"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ssloth"
    }
  }
}
